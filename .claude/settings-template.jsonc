// ============================================================
//  金庫（禁止事項）の見本
//  第8号「AI従業員に『開けさせない金庫』をつくる」に対応します。
//
//  【AI従業員へ】
//  **このファイルは、設定としては読み込まれません。** 見本です。
//  実際に効いているのは、隣にある `settings.json` です。そちらには
//  「どの会社でも止めてよいもの」だけが、最初から入っています。
//
//  会社に合わせた禁止事項を足すときは、この見本から必要な行を選び、
//  `settings.json` の "deny" に**書き足して**ください。
//  「//」で始まる行は写しません（設定の形が壊れます）。
//  **`settings.json` を丸ごと置き換えないでください。**
//
//  【この会社の社長へ】
//  ここに書いた操作は、AI従業員がお願いされても実行できなくなります。
//  CLAUDE.md に書く「お願い」とは効き方が違います。あちらは口頭の申し送り、
//  こちらは鍵のかかった金庫です。
//
//  【何を禁止するかの決め方】第8号でお伝えした2つの問いです。
//  　　問1：その行為が実行されても、あとから元に戻せるか
//  　　問2：その行為が、AIの解釈違いや、悪意ある第三者の誘導によって、
//  　　　　 絶対に起こらないと言い切れるか
//  どちらか一方でも「いいえ」なら、お願い（CLAUDE.md）では足りません。
//  ここに書いて、鍵をかけてください。
//
//  設定したら、必ず動くことを確かめてください。書いたのに効いていない状態が
//  いちばん危険です。確かめ方は、いちばん下にあります。
// ============================================================
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {

    "deny": [

      // --- 1. 重要なファイルの削除 ---------------------------------
      // この3行は、キットの .claude/settings.json には入っていません。見本です。
      // キットに最初から入っているのは、Bash(rm -rf *) と Bash(rm -fr *) の2行だけで、
      // これは Mac でしか働きません（理由は下の【Windowsをお使いの方へ】）。
      // 削除そのものを止めると決めたら、この3行を settings.json に書き写してください。
      // 第8号でご紹介した事故が、まさにこれです。
      // これを入れると、AI従業員は削除のコマンド（rm・rmdir・Remove-Item）を
      // 使えなくなり、ファイルの削除はあなたの手作業になります。
      // 「不便だ」と感じたら外せますが、外す前に第9号のバックアップが
      // 動いていることを確かめてください。
      // 【Windowsをお使いの方へ・大事なところ】
      // Windows では PowerShell が使われます。Git for Windows を入れると Bash も
      // 使えるようになりますが、PowerShell が使えなくなるわけではありません
      // （公式ドキュメントの記述。両方が使える状態になります）。
      // **そのため Bash 側だけを塞いでも、PowerShell 経由で通ってしまいます。**
      // 以下は Bash と PowerShell を必ず対で書いています。
      // Mac・Linux をお使いの方は、PowerShell の行を消して構いません。
      "Bash(rm *)",
      "Bash(rmdir *)",
      "PowerShell(Remove-Item *)",

      // --- 2. 変更履歴を巻き戻す操作と、記録していないファイルを消す操作 ---
      // git reset は、変更履歴（第9号で入れた Git）を過去の時点まで巻き戻します。
      // 巻き戻すと、まだ記録していない作業が消え、巻き戻した分の記録も今の履歴から
      // 外れます。git clean は、変更履歴に記録していないファイルを消します。
      // どちらも、AI従業員に実行させないための禁止です。
      "Bash(git reset *)",
      "Bash(git clean *)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",

      // --- 3. 機密情報を読むこと -----------------------------------
      // 接続の鍵は、デジタルオフィスの外へ移すことになっています（手順は第9号）。
      // その作業は進捗の表の⑱です。まだ「未」のことがあります。
      // 先頭の「//」は、パソコン全体を指す書き方です。
      // どこに置いてあっても、**直接は**読めなくなります。
      // ただし抜け道がゼロになるわけではありません（別のプログラム越しに
      // 読ませる等）。設定に頼り切らず、そもそも鍵をオフィスの中に
      // 置かないでください。第8号の「金庫も万能ではない」がここです。
      // この10行は、キットの .claude/settings.json に最初から入っています（同じ並びです）。
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.env)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/*credential*)",
      "Read(//**/*token*.json)",
      "Read(//**/*secret*.json)",

      // --- 4. 機密情報を外へ送ること -------------------------------
      // インターネットへ直接データを送る道を塞ぎます。
      // この下の allow に書いたサイトは、AI従業員が社長の確認なしで読めます。
      // それ以外のサイトを読むときは、許可モードが既定のままなら、そのたびに社長の
      // 画面に確認が出ます（Claude Code があらかじめ許可している一部の技術資料の
      // サイトは、確認なしで読めます）。
      "Bash(curl *)",
      "Bash(curl.exe *)",
      "Bash(wget *)",
      // PowerShell では、同じ操作に呼び方がいくつかあります。iwr・irm は
      // Invoke-WebRequest・Invoke-RestMethod の別名で、Claude Code は禁止を判定する
      // ときに、別名を本来の名前と同じものとして扱います。
      // ただし curl・wget が別名なのは古い PowerShell（5.1）だけで、新しい
      // PowerShell（7）では別名ではありません。さらに Windows には curl.exe という
      // 別のプログラムも入っています。そのため、呼び方を並べて書いています。
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(curl *)",
      "PowerShell(curl.exe *)",
      "PowerShell(wget *)",

      // --- 5. パソコンの設定そのものを変えること -------------------
      "Bash(sudo *)"

      // --- 6. お金を動かすこと（あなたの環境に合わせて足します） ---
      // 会計ソフトや銀行につないだときに、ここへ足してください。
      // つないでいないうちは、書いても何も起きません。
      // 逆に言えば、つなぐ前に書いておけば、つないだ瞬間から効きます。
      //
      // 例（実際のつなぎ先の名前に置き換えてください）:
      //   "mcp__freee"
      //   "mcp__stripe"
      //
      // 注意：この形では括弧を使えません。括弧を付けると、その行は
      //       読み飛ばされます（設定として無視されます）。
      //       つなぎ先の名前だけを書いてください。

      // --- 7. 外に公開すること（あなたの環境に合わせて足します） ---
      // 会社のSNSやサイトにつないだときに、ここへ足してください。
      // 例:
      //   "mcp__wordpress"
      //   "mcp__x"

      // --- 8. 変更履歴やデータベースをつないだとき（あなたの環境に合わせて足します）---
      // 変更履歴を、インターネット上の保存場所（GitHub など）にも置くようになったとき、
      // 保存場所の履歴を強制的に書き換える送信は、もう止まっています。
      //   "Bash(git push --force *)"・"Bash(git push -f *)" と、PowerShell の対の2行は、
      //   キットの settings.json に最初から入っています。足す必要はありません。
      // データベースをつないだら、表を丸ごと消す命令・表の内容を全部消す命令
      // （DROP TABLE・TRUNCATE TABLE）を止める設定を、つなぎ先に合わせて足してください。
    ],

    "allow": [
      // ここに書いたサイトは、AI従業員が社長の確認なしで読めます（それ以外の
      // サイトは、許可モードが既定のままなら、読むたびに社長の画面に確認が出ます）。
      // よく使うサイトを足してください。

      // この2行は、キットの .claude/settings.json に最初から入っています。
      // オフィス開設キットの更新確認に使います（消さないでください）。
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",

      // ここから下の3行は、まだ入っていません。書き方の見本です。
      // 足したいものがあれば、.claude/settings.json の allow に書き写してください。

      // Claude Code の公式ドキュメント。
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",

      // 官公庁。制度・法令・統計を調べるときに使います。
      "WebFetch(domain:*.go.jp)"
    ]
  }
}

// ============================================================
//  知っておいていただきたいこと
//
//  ● 禁止が最優先です
//    公式ドキュメントによると、ルールは「禁止 → 確認 → 許可」の順に
//    見られ、最初に当たったものが結果を決めます。
//    つまり、いったん禁止に書いたものは、あとから許可に書いても通りません。
//    「これだけは例外で」ということができないので、禁止は広めに書き、
//    必要になったら禁止のほうを直します。
//
//  ● 塞げるのは、AI従業員が届く範囲だけです
//    まだ銀行にも会計ソフトにもつないでいないなら、そこには
//    塞ぐものがありません。危険が無いのではなく、まだ道が無いだけです。
//    道をつなぐときに、この金庫に鍵を足してください。
//
//  ● 万能ではありません
//    書き方の抜け道で、すり抜けが起きる可能性はゼロではありません。
//    それでも「お願い」だけの状態とは、安全性が段違いです。
//    金庫（これ）と保険（第9号のバックアップ）の両方を持ってください。
//
//  ● 止められても、金庫を緩めない
//    害の無い操作が金庫に止められても、金庫の設定を緩めないでください。
//    同じことを別の書き方でできないかを考えます。
//    また、金庫が止めない危険な操作もあります（ここに書いていないもの）。
//    金庫が無条件に止めるのは、上の deny に書いた操作だけです。書いていない操作は、
//    許可モードが既定のままなら、実行の前に社長の画面に確認が出ます（上の
//    「禁止が最優先です」を参照）。確認が出ない設定で使うときや、どちらにも
//    当たらない危険な操作は、実行の前に社長の確認を取って守ります（確認を取る
//    操作の一覧は .claude/rules/safety.md にあります）。
//
//  ● 見張るより、道を断つほうが強い
//    怪しいものを見つけて止める仕組みは、知っている形しか捕まえられません。
//    送り先を固定する、そもそも道を作らない、という守り方のほうが確実です。
//    検査に通ったことを、安全の証拠にしないでください。機械の検査と、
//    社長の確認の二重で守ります。
//
//  ● 確認の画面で守るのは、安全だけ
//    「よろしいですか」の確認で守るのは、元に戻せないこと・外に出ること・
//    お金や認証情報が動くこと、の3つです。確認の画面にはコマンドの文字しか
//    出ないので、仕事の質は判断できません。質は、手順の中の確認で守ります。
//    許可（allow）を書くときは、1回分の具体的なコマンドではなく、
//    "Bash(git status *)" のような形で書いてください。1回分のコマンドを
//    許可しても、次に少し違えば、また確認が出ます。
//
//  ● 最後に必ず確かめる
//    書いただけで満足しないでください。もっともらしい設定と、
//    本当に効いている設定は別物で、実際に試さないと区別できません。
//    AI従業員にこう頼んで、止まるところを見てください。
//
//      「追加した禁止ルールが正しく機能するか確認したいです。
//        本番のデータには影響を与えない安全な方法でテストしてください。
//        実行しようとした操作が拒否される様子を見せてください。
//        もし安全なテスト方法がない場合は、実行せず、理由を説明してください」
//
//  参考にした公式ドキュメント（設定の書き方と、禁止が優先される仕組み）
//    https://code.claude.com/docs/en/settings
//    https://code.claude.com/docs/en/permissions
// ============================================================
