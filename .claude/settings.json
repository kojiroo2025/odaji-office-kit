{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "Bash(curl *)",
      "Bash(curl.exe *)",
      "Bash(wget *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(curl *)",
      "PowerShell(curl.exe *)",
      "PowerShell(wget *)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.env)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/*credential*)",
      "Read(//**/*token*.json)",
      "Read(//**/*secret*.json)"
    ],
    "allow": [
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)"
    ]
  }
}
