# ============================================================
#  変更履歴に残さないもののひな形
#  第9号「AI従業員が失敗しても、元に戻せる仕組みを作る」に対応します。
#
#  【AI従業員へ】
#  このファイルは、最初から効いています。置き直す作業はありません。
#  社長がすでに .gitignore を持っている環境では、消さずに、
#  足りない行だけを足してください。
#
#  行を足すのに、社長の確認は要りません。足したあとで、
#  何を記録から外したかを1行で伝えてください。
#
#  【この会社の社長へ】
#  Git は「変えたところ」を記録していく仕組みです。何でも記録すればよい
#  わけではありません。記録してはいけないもの（鍵）と、記録しても意味が
#  ないもの（一時ファイル）があります。ここは、その線引きです。
# ============================================================


# ------------------------------------------------------------
# 1. 絶対に記録してはいけないもの（鍵）
#
#    接続の鍵は、デジタルオフィスの外へ移すことになっています（手順は第9号）。
#    その作業は進捗の表の⑱です。まだ「未」のことがあります。
#    済んでいても、ダウンロードしたものがうっかりここに置かれることがあります。
#    そのときに記録されないようにしておきます。
#
#    Git はいちど記録すると、あとから消しても履歴に残ります。
#    「あとで消す」が効かないので、最初から入れません。
# ------------------------------------------------------------
.env
.env.*
*.pem
*.key
# 個人だけの設定。共有すると他の人の環境を壊します。
CLAUDE.local.md
.claude/settings.local.json
*.p12
*.pfx
credentials*.json
*credentials*.json
*token*.json
*secret*.json
client_secret*.json


# ------------------------------------------------------------
# 2. 記録しても意味がないもの（一時ファイル・自動で作られるもの）
#
#    消えても困りません。記録すると履歴が読みにくくなるだけです。
# ------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
~$*
.cache/
__pycache__/
*.pyc
node_modules/
.venv/
venv/


# ------------------------------------------------------------
# 3. パソコンが勝手に作るもの
# ------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store


# ------------------------------------------------------------
# 4. 大きすぎるもの
#
#    Git は文章・設定・プログラムのような「行で読めるもの」に向いています。
#    Git は、記録するたびに、変わったファイルを保存し直します。動画や圧縮
#    ファイルは1つが大きいので、少し変えて記録するたびに、デジタルオフィスの
#    フォルダがどんどん大きくなります。
#
#    これらを守るのは、変更履歴ではなく、オフィスの外へのバックアップのほうです。
#    ただし、そのバックアップはキットに入っていません。作るのは社長です（手順は第9号）。
#    進捗の表の⑯と⑰が済むまで、ここで除外したものは、どこにも控えがありません。
#    変更履歴とバックアップは役割が違う、というお話のとおりです。
# ------------------------------------------------------------
*.mp4
*.mov
*.avi
*.zip
*.7z
*.psd
*.ai
*.tif
*.tiff


# ------------------------------------------------------------
# 5. 画像について（ここだけ、判断が分かれます）
#
#    第9号では画像も対象から外す例として挙げました。ただ、ロゴや
#    説明用の画面写真は小さく、いつ差し替えたかが分かると助かります。
#    このひな形では、次のようにしています。
#
#      記録する ： .png .jpg .svg （ロゴ・画面写真など。小さいもの）
#      記録しない： 上の 4. に挙げた大きな形式
#
#    ロゴを何度も作り直す予定がある方や、写真素材をたくさん置く方は、
#    AI従業員に相談して変えてください。正解は会社ごとに違います。


# ------------------------------------------------------------
# 6. あなたの会社で足すもの
#
#    お客様から預かったファイル、個人情報を含む名簿、まだ公表していない
#    計画。こうしたものを置く場所を決めたら、ここに足してください。
#
#    例:
#      お客様から預かったファイル/
#      個人情報/
# ------------------------------------------------------------
