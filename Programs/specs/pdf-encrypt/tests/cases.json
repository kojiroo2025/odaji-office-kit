[
  {
    "id": "ok",
    "args": [
      "{fixtures}/src.pdf",
      "--out",
      "{tmp}/out/a.pdf",
      "--password-file",
      "{tmp}/pw/a.txt"
    ],
    "expect_exit": 0,
    "expect_stdout_contains": [
      "パスワードを付けました",
      "AES-256",
      "2ページ",
      "a.pdf",
      "a.txt"
    ],
    "expect_stdout_not_contains": [],
    "note": "ふつうの実行。出力とパスワードのファイルができる。書きかけのファイルは残らない。パスワード（保存先のファイルの2行目）は画面に出ない。パスワードの保存先のフォルダは、なければ作る",
    "setup_dirs": [
      "{tmp}/out"
    ],
    "expect_exists": [
      "{tmp}/out/a.pdf",
      "{tmp}/pw/a.txt"
    ],
    "expect_not_exists": [
      "{tmp}/out/a.pdf.part"
    ],
    "expect_output_hides_line": {
      "file": "{tmp}/pw/a.txt",
      "line": 2
    },
    "expect_file_contains": [
      {
        "file": "{tmp}/out/a.pdf",
        "text": "/Encrypt"
      },
      {
        "file": "{tmp}/out/a.pdf",
        "text": "/AESV3"
      }
    ],
    "expect_file_differs": [
      {
        "file": "{tmp}/out/a.pdf",
        "other": "{fixtures}/src.pdf"
      }
    ],
    "expect_file_line_matches": [
      {
        "file": "{tmp}/pw/a.txt",
        "line": 2,
        "pattern": "[A-HJ-NP-Za-km-z2-9]{16}"
      }
    ],
    "expect_pdf_password": {
      "pdf": "{tmp}/out/a.pdf",
      "password_file": "{tmp}/pw/a.txt",
      "line": 2,
      "pages": 2
    }
  },
